# Ignore node_modules for both frontend and backend
node_modules/
**/node_modules/

# Ignore .env files (config, secrets)
.env
**/.env

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build and dist folders
dist/
build/
**/dist/
**/build/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE and editor folders
.vscode/
.idea/

# Ignore package lock files if using yarn
package-lock.json
yarn.lock

# Ignore coverage from testing
coverage/
**/coverage/
